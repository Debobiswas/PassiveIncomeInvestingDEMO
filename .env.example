# Server only. Use a local/staging publishable key, never a service-role/secret key.
# This file contains placeholders, not usable credentials.
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally

# Optional locally; required by the hosted root build. Never put these in VITE_*.
# SENTRY_DSN=https://publickey@o123.ingest.us.sentry.io/123
# PII_RELEASE=<full-40-character-git-commit-sha>
# PII_ENVIRONMENT=staging
# PII_READINESS_KEY=<random-32-to-128-character-url-safe-server-secret>
# Read-only release smoke only; use a fresh synthetic account session:
# PII_SMOKE_URL=https://approved-staging-origin.example
# PII_SMOKE_ACCESS_TOKEN=<short-lived-synthetic-user-access-token>
